# Copie este arquivo para ".env" (local) e preencha.
# Na Vercel: Project → Settings → Environment Variables (mesmos nomes).
# NUNCA suba o .env para o GitHub.

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Qualquer texto longo e aleatório. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Local: porta do servidor (a Vercel ignora)
PORT=3000

# "false" = não tentar criar as tabelas ao iniciar (use se o usuário do banco não tiver permissão de CREATE)
AUTO_MIGRATE=true
